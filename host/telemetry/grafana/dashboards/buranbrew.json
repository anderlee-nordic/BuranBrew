      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest_sensor AS (\n  SELECT DISTINCT ON (metric) metric, value, ts\n  FROM sensor_data\n  WHERE metric IN ('ambient', 'internal', 'gravity')\n  ORDER BY metric, ts DESC\n), rows AS (\n  SELECT\n    1 AS ord,\n    'Internal' AS item,\n    coalesce((SELECT to_char(value, 'FM990.00') FROM latest_sensor WHERE metric = 'internal'), '-') AS value,\n    '°C' AS unit,\n    (SELECT ts FROM latest_sensor WHERE metric = 'internal') AS updated\n  UNION ALL\n  SELECT\n    2 AS ord,\n    'Gravity' AS item,\n    coalesce((SELECT to_char(value, 'FM990.000') FROM latest_sensor WHERE metric = 'gravity'), '-') AS value,\n    'SG' AS unit,\n    (SELECT ts FROM latest_sensor WHERE metric = 'gravity') AS updated\n  UNION ALL\n  SELECT\n    3 AS ord,\n    'Ambient' AS item,\n    coalesce((SELECT to_char(value, 'FM990.00') FROM latest_sensor WHERE metric = 'ambient'), '-') AS value,\n    '°C' AS unit,\n    (SELECT ts FROM latest_sensor WHERE metric = 'ambient') AS updated\n  UNION ALL\n  SELECT\n    4 AS ord,\n    'Control' AS item,\n    coalesce((SELECT action FROM control_events ORDER BY ts DESC LIMIT 1), '-') AS value,\n    'N/A' AS unit,\n    (SELECT ts FROM control_events ORDER BY ts DESC LIMIT 1) AS updated\n)\nSELECT\n  item AS \"Item\",\n  value AS \"Value\",\n  unit AS \"Unit\",\n  coalesce(to_char(updated, 'YYYY-MM-DD HH24:MI:SS'), '-') AS \"Updated\"\nFROM rows\nORDER BY ord",
          "refId": "A"
        }
      ],
      "title": "Current status",
      "type": "table"
    },
