        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH b AS (\n  SELECT *\n  FROM batches\n  ORDER BY (ended_at IS NULL) DESC, started_at DESC\n  LIMIT 1\n), current_batch AS (\n  SELECT\n    coalesce((SELECT batch_id FROM b), 0) AS batch_id,\n    coalesce((SELECT name FROM b), 'Batch #0') AS name,\n    (SELECT style FROM b) AS style,\n    (SELECT vessel FROM b) AS vessel,\n    coalesce((SELECT started_at FROM b), now()) AS started_at,\n    (SELECT ended_at FROM b) AS ended_at,\n    (SELECT og FROM b) AS og,\n    (SELECT target_fg FROM b) AS target_fg,\n    (SELECT notes FROM b) AS notes\n)\nSELECT * FROM (\n  SELECT 1 AS ord, 'Batch #' AS \"Field\", batch_id::text AS \"Value\" FROM current_batch\n  UNION ALL SELECT 2, 'Name', name FROM current_batch\n  UNION ALL SELECT 3, 'Beer type', coalesce(style,'-') FROM current_batch\n  UNION ALL SELECT 4, 'Vessel', coalesce(vessel,'-') FROM current_batch\n  UNION ALL SELECT 5, 'Started', to_char(started_at,'YYYY-MM-DD HH24:MI') FROM current_batch\n  UNION ALL SELECT 6, 'Ended', coalesce(to_char(ended_at,'YYYY-MM-DD HH24:MI'),'(active)') FROM current_batch\n  UNION ALL SELECT 7, 'Age (days)', round(extract(epoch FROM (coalesce(ended_at,now())-started_at))/86400.0, 1)::text FROM current_batch\n  UNION ALL SELECT 8, 'OG', coalesce(og::text,'-') FROM current_batch\n  UNION ALL SELECT 9, 'Target FG', coalesce(target_fg::text,'-') FROM current_batch\n  UNION ALL SELECT 10,'Notes', coalesce(notes,'-') FROM current_batch\n) t\nORDER BY ord",
          "refId": "A"
        }
      ],
